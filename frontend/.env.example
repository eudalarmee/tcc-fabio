# Backend API URL
VITE_API_URL=http://localhost:3000/api

# ====================================
# CONFIGURAÇÃO DA IA - MUSCLEMAX
# ====================================

# Provider de IA (openai | gemini | azure | mock)
# Por padrão usa 'openai' - se não tiver API key, usa fallback inteligente
VITE_AI_PROVIDER=openai

# ====================================
# OPENAI (GPT-4) - RECOMENDADO ⭐
# ====================================
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Descomente a linha abaixo e cole sua API key:
# VITE_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# GOOGLE GEMINI (ALTERNATIVA)
# ====================================
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
# VITE_GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# AZURE OPENAI (EMPRESARIAL)
# ====================================
# VITE_AZURE_ENDPOINT=https://seu-recurso.openai.azure.com/
# VITE_AZURE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# INSTRUÇÕES DE USO
# ====================================
# 1. Copie este arquivo para .env (cp .env.example .env)
# 2. Descomente e preencha a API key desejada
# 3. Reinicie o servidor (npm run dev)
# 4. A IA estará 100% funcional!
#
# ⚠️ ATENÇÃO: Nunca commite o arquivo .env no Git
# O .gitignore já está configurado para ignorá-lo

