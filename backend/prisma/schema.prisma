datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  workouts  Workout[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  muscleGroup String   // "Costas", "Pernas", "Peito", "Ombros", "Bíceps", "Tríceps", "Core"
  equipment   String?  // "Máquina", "Barra", "Halteres", "Peso corporal"
  difficulty  String?  // "Iniciante", "Intermediário", "Avançado"
  mediaUrl    String?  // gif/video opcional
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       WorkoutExercise[]
}

model Workout {
  id        String             @id @default(cuid())
  title     String
  ownerId   String
  owner     User               @relation(fields: [ownerId], references: [id])
  items     WorkoutExercise[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  workoutId   String
  exerciseId  String
  orderIndex  Int
  sets        Int      @default(3)
  reps        String   @default("8-12")
  restSec     Int?
  workout     Workout  @relation(fields: [workoutId], references: [id])
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, orderIndex])
}

